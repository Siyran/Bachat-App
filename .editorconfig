# EditorConfig helps developers define and maintain consistent
# coding styles across various editors and IDEs.
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 4
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.swift]
indent_size = 4
indent_style = space

[*.{md,markdown}]
trim_trailing_whitespace = false
indent_size = 2

[*.{json,yml,yaml}]
indent_size = 2
